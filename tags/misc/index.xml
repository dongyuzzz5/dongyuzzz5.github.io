&gt; &lt;img src=&#34;https://dongyuzzz5.github.io/p/misc1/2.7.jpg&#34;
	width=&#34;379&#34;
	height=&#34;705&#34;
	srcset=&#34;https://dongyuzzz5.github.io/p/misc1/2.7_hu_e4be0cd6374c9337.jpg 480w, https://dongyuzzz5.github.io/p/misc1/2.7_hu_f74ff7ac05afc17e.jpg 1024w&#34;
